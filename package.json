{
  "name": "tahadi-tawjihi-islamic",
  "version": "2.3.0",
  "private": true,
  "description": "منصة تحدي التوجيهي — إيميل وكلمة مرور خاصة بالموقع وضيف مؤقت",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:browser": "node tests/browser.spec.mjs",
    "check": "npm run build && npm test && npm run test:browser && npm run test:auth",
    "test:auth": "node tests/auth-ui.spec.mjs"
  },
  "engines": {
    "node": ">=22.8"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.62.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0"
  }
}
